---
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const {
  description = "Find the top-level domain that's right for you.",
  title = "TL;DR",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
