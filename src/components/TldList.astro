---
interface TldItem {
  readonly description: string;
  readonly domain: string;
  readonly label: string;
  readonly relevance?: number;
}

interface Props {
  items: ReadonlyArray<TldItem>;
}

const { items } = Astro.props;
---

<ul class="tld-list">
  {items.map((item) => (
    <li class="tld-card">
      <div>
        <p class="tld-domain">{item.domain}</p>
        <h3>{item.label}</h3>
      </div>
      <p>{item.description}</p>
    </li>
  ))}
</ul>
