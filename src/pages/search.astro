---
import * as Effect from "effect/Effect";

import SearchForm from "../components/SearchForm.astro";
import TldList from "../components/TldList.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { searchTlds } from "../server/SearchTlds";

export const prerender = false;

const query = Astro.url.searchParams.get("q") ?? "";

const outcome = await Effect.runPromise(
  searchTlds(Astro.locals.runtime.env.AI, query).pipe(
    Effect.match({
      onFailure: (error) => ({ error, results: [] }),
      onSuccess: (results) => ({ error: undefined, results }),
    }),
  ),
);

const { error, results } = outcome;
---

<PageLayout title={query ? `${query} — TL;DR` : "Search — TL;DR"}>
  <header class="compact-header">
    <a class="wordmark" href="/" aria-label="TL;DR home">TL;DR</a>
    <SearchForm query={query} />
  </header>

  <section aria-live="polite" aria-labelledby="results-heading">
    {
      error ? (
        <div class="message error">
          <h1 id="results-heading">We couldn't search that</h1>
          <p>{error.message}</p>
        </div>
      ) : (
        <>
          <div class="section-heading">
            <h1 id="results-heading">The right endings for “{query.trim()}”</h1>
            <p>Ranked by meaning, audience, and intent.</p>
          </div>
          <TldList items={results} />
        </>
      )
    }
  </section>
</PageLayout>
