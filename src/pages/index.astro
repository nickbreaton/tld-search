---
import { Effect } from "effect";

import { TldCatalog } from "../server/TldCatalog";

export const prerender = false;

const { allTlds, asciiTlds } = await Effect.runPromise(
  Effect.gen(function* () {
    const catalog = yield* TldCatalog;

    return {
      allTlds: catalog.list({ excludeNonAscii: false }),
      asciiTlds: catalog.list({ excludeNonAscii: true }),
    };
  }).pipe(Effect.provide(TldCatalog.layer)),
);

const asciiTldSet = new Set(asciiTlds);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <input
      id="query"
      type="search"
      name="q"
      maxlength="120"
      placeholder="Search by phrase, idea, or feeling"
      autofocus
    />

    <label>
      <input id="ascii-only" type="checkbox" checked />
      Hide domain endings with non-ASCII characters
    </label>

    <ul id="tlds">
      {
        allTlds.map((tld) => (
          <li data-ascii={asciiTldSet.has(tld)} hidden={!asciiTldSet.has(tld)}>{tld}</li>
        ))
      }
    </ul>

    <script>
      const input = document.querySelector<HTMLInputElement>("#query");

      const asciiOnly = document.querySelector<HTMLInputElement>("#ascii-only");

      const list = document.querySelector<HTMLUListElement>("#tlds");

      const initialItems = Array.from(list?.querySelectorAll("li") ?? []);

      const allTlds = initialItems.map((item) => item.textContent ?? "");

      const asciiTlds = initialItems
        .filter((item) => item.dataset.ascii === "true")
        .map((item) => item.textContent ?? "");

      let timeout: ReturnType<typeof setTimeout> | undefined;

      let request: AbortController | undefined;

      const renderTlds = (tlds: ReadonlyArray<string>) => {
        list?.replaceChildren(...tlds.map((tld) => Object.assign(document.createElement("li"), { textContent: tld })));
      };

      input?.addEventListener("input", () => {
        clearTimeout(timeout);
        request?.abort();

        const query = input.value.trim();

        if (!query) {
          renderTlds(asciiOnly?.checked ? asciiTlds : allTlds);

          return;
        }

        timeout = setTimeout(async () => {
          request = new AbortController();

          try {
            const search = new URLSearchParams({
              q: query,
              asciiOnly: String(asciiOnly?.checked ?? true),
            });

            const response = await fetch(`/api/search?${search}`, {
              signal: request.signal,
            });

            if (response.ok) {
              // SAFETY: This response comes from our typed `/api/search` endpoint.
              const result = (await response.json()) as { readonly tlds: ReadonlyArray<string> };

              renderTlds(result.tlds);
            } else {
              const error = await response.text();

              console.error(`TLD search failed (${response.status}): ${error}`);
            }
          } catch (error) {
            if (!(error instanceof DOMException && error.name === "AbortError")) {
              console.error(error);
            }
          }
        }, 500);
      });

      asciiOnly?.addEventListener("change", () => {
        input?.dispatchEvent(new Event("input"));
      });
    </script>
  </body>
</html>
