---
import { Effect } from "effect";

import { allTlds, TldCatalog } from "../server/TldCatalog";

export const prerender = false;

const tlds = await Effect.runPromise(allTlds.pipe(Effect.provide(TldCatalog.layer)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <input type="search" name="q" placeholder='Search by phrase, idea, or feeling' autofocus />

    <ul>
      {tlds.map((tld) => <li>{tld}</li>)}
    </ul>
  </body>
</html>
